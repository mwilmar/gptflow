# GPTFlow Environment Variables

# AI (Groq - primary, free: https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# AI (OpenAI - fallback: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your_key_here

# AI Provider: groq, openai, or hybrid
AI_PROVIDER=hybrid

# Database
DATABASE_URL=postgresql+asyncpg://gptflow:gptflow123@localhost:5432/gptflow

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (generate: openssl rand -hex 32)
JWT_SECRET=your-secret-key-min-32-chars-here
JWT_EXPIRE_MINUTES=1440

# Instagram / Facebook (future)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8000/api/v1/accounts/callback

# App
APP_ENV=development
DEBUG=true

# Unsplash (free image search: https://unsplash.com/oauth/applications)
UNSPLASH_ACCESS_KEY=your_access_key_here
